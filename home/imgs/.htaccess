RewriteEngine on
# Allow empty referer (direct access)
RewriteCond %{HTTP_REFERER} !^$
# Allow our main domain
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?mautranhcnc\.com [NC]
# Allow localhost and common development domains
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?localhost [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://127\.0\.0\.1 [NC]
# Forbid others
RewriteRule \.(jpg|jpeg|png|gif)$ - [F]
