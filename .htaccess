# ─────────────────────────────────────────────────────────────
# MT CNC SECURITY SHIELD - ANTI-GRAVITY GUARD
# ─────────────────────────────────────────────────────────────

# 1. NGĂN CHẶN DUYỆT THƯ MỤC (DIRECTORY INDEXING)
Options -Indexes

# 2. CHẶN TRUY CẬP TRỰC TIẾP VÀO CÁC TỆP NHẬY CẢM (DOTFILES, LOGS, DB)
# Ngăn chặn việc tải về các tệp cấu hình, nhật ký và bản sao lưu.
<FilesMatch "^\.env|^\.sql|^\.git|.*\.log$|.*\.bak$|.*\.conf$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. BẢO VỆ PHỤ TRỢ (EXTENSION PROTECTION)
# Chặn các kiểu file mã nguồn hoặc tệp tạm khác
<FilesMatch "\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|env|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. CHẶN TRUY CẬP THƯ MỤC NỘI BỘ (INTERNAL FOLDER PROTECTION)
# Chặn hoàn toàn việc truy cập trực tiếp vào các thư mục mã nguồn.
RewriteEngine On
RewriteRule ^includes/.*$ - [F,L]
