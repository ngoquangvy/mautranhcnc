# ─────────────────────────────────────────────────────────────
# MÔI TRƯỜNG: local | production
# ─────────────────────────────────────────────────────────────
APP_ENV=production
SESSION_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────
# DATABASE CONFIG
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ngovy_maucnc

# ─────────────────────────────────────────────────────────────
# CLOUDFLARE WORKER (Thông báo đơn hàng qua Telegram)
# ─────────────────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=https://your-worker.your-subdomain.workers.dev/notify
WEBHOOK_SECRET=your_long_random_webhook_secret

# ─────────────────────────────────────────────────────────────
# RECAPTCHA CONFIG (Lấy từ Google reCAPTCHA Console - Standard v2)
# ─────────────────────────────────────────────────────────────
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# ─────────────────────────────────────────────────────────────
# CẤU HÌNH QUYỀN HẠN ADMIN
# ─────────────────────────────────────────────────────────────
# Cho phép xóa vĩnh viễn đơn hàng (Hủy Diệt) - Mặc định là false để an toàn
#ADMIN_CAN_DELETE_ORDER=true
ADMIN_CAN_DELETE_ORDER=false

# ─────────────────────────────────────────────────────────────
# CẤU HÌNH THÔNG BÁO EMAIL (Dùng thay cho Telegram trên Host free)
# ─────────────────────────────────────────────────────────────
SENDER_EMAIL=bot@yourdomain.com
ADMIN_EMAIL=your-email@gmail.com

# ─────────────────────────────────────────────────────────────
# SSL CONFIG
# ─────────────────────────────────────────────────────────────
# Mặc định là true (Bảo mật cao). Chỉ đặt thành false ở local nếu bạn thiếu CA Cert.
#SSL_VERIFY=false
SSL_VERIFY=true

# ─────────────────────────────────────────────────────────────
# CHÌA KHÓA DEV (Dùng cho cleanup_orphans.php - Dọn ảnh rác)
# ─────────────────────────────────────────────────────────────
# Đặt một chuỗi bí mật bất kỳ. Chỉ Developer biết mã này mới chạy được công cụ dọn dẹp.
DEV_CLEANUP_KEY=your_secret_dev_key_here
