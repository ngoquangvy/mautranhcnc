APP_ENV=production
SESSION_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_NAME=ngovy_maucnc
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# reCAPTCHA
# RECAPTCHA CONFIG (Lấy từ Google reCAPTCHA Console)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# SSL verification for outbound HTTPS requests
SSL_VERIFY=true

# Notification bridge (Client -> Cloudflare Worker -> Telegram)
NOTIFY_WEBHOOK_URL=https://your-worker.your-subdomain.workers.dev/notify
WEBHOOK_SECRET=your_long_random_webhook_secret

# ─────────────────────────────────────────────────────────────
# CẤU HÌNH THÔNG BÁO EMAIL (Dùng thay cho Telegram trên Host free)
# ─────────────────────────────────────────────────────────────
SENDER_EMAIL=bot@yourdomain.com
ADMIN_EMAIL=your-email@gmail.com
